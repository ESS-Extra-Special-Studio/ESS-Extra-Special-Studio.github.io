---
import type { EswNavItem } from "../types";

type Props = {
  homeHref?: string;
  badgeSrc: string;
  badgeAlt: string;
  items: EswNavItem[];
  currentPath: string;
};

const { homeHref = "/", badgeSrc, badgeAlt, items, currentPath } = Astro.props as Props;

function current(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={homeHref}>
      <img class="brand-badge" src={badgeSrc} alt={badgeAlt} width="48" height="48" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-btn">
      Menu
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {
        items.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById("menu-btn");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
