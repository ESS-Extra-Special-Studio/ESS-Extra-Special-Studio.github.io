---
import type { EswExternalLinks } from "../types";

const { links } = Astro.props as { links: EswExternalLinks };

const defs: { key: keyof EswExternalLinks; label: string }[] = [
  { key: "buy", label: "Buy license" },
  { key: "download", label: "Download" },
  { key: "github", label: "GitHub" },
  { key: "curseforge", label: "CurseForge" },
  { key: "modrinth", label: "Modrinth" },
  { key: "docs", label: "Docs" },
  { key: "spotify", label: "Spotify" },
  { key: "bandcamp", label: "Bandcamp" },
  { key: "youtube", label: "YouTube" },
  { key: "steam", label: "Steam" },
  { key: "itch", label: "itch.io" },
  { key: "patreon", label: "Patreon" },
  { key: "buymeacoffee", label: "Buy Me a Coffee" },
  { key: "kofi", label: "Ko-fi" },
  { key: "discord", label: "Discord" },
  { key: "email", label: "Email" },
];

const present = defs.filter((d) => Boolean(links[d.key]?.trim()));
---

<div class="links">
  {
    present.map((d) => (
      <a
        class="btn"
        href={d.key === "email" && links.email && !links.email.startsWith("mailto:") ? `mailto:${links.email}` : links[d.key]}
        rel="noopener noreferrer"
      >
        {d.label}
      </a>
    ))
  }
  {
    present.length === 0 && (
      <span class="btn" aria-disabled="true">Coming soon</span>
    )
  }
</div>
