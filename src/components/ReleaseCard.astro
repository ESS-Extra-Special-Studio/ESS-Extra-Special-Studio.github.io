---
import EswReleaseCard from "../../esw/components/EswReleaseCard.astro";
import type { Release } from "../data/music";

const { artistId, release } = Astro.props as { artistId: string; release: Release };
---

<EswReleaseCard
  href={`/music/${artistId}/${release.id}`}
  title={release.title}
  kind={release.kind}
  year={release.year}
/>
