---
import EswProjectCard from "../../esw/components/EswProjectCard.astro";
import type { Mod } from "../data/mods";

const { mod } = Astro.props as { mod: Mod };
---

<EswProjectCard
  href={`/mods/${mod.id}`}
  title={mod.name}
  description={mod.short}
  status={mod.status}
  icon={mod.icon}
  pixelIcon={mod.pixelIcon}
/>
