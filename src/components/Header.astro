---
import EswHeader from "../../esw/components/EswHeader.astro";

const path = Astro.url.pathname;
const items = [
  { href: "/", label: "Home" },
  { href: "/mods", label: "Mods" },
  { href: "/music", label: "Music" },
  { href: "/games", label: "Games" },
  { href: "/studio", label: "Studio" },
  { href: "/help", label: "Help" },
  { href: "/donate", label: "Donate" },
];
---

<EswHeader
  badgeSrc="/images/brand/badge.png"
  badgeAlt="Extra Special Studio"
  items={items}
  currentPath={path}
/>
