---
import EswFooter from "../../esw/components/EswFooter.astro";
import { studio } from "../data/studio";

const items = [
  { href: "/", label: "Home" },
  { href: "/mods", label: "Mods" },
  { href: "/modpacks", label: "Modpacks" },
  { href: "/music", label: "Music" },
  { href: "/games", label: "Games" },
  { href: "/software", label: "Software" },
  { href: "/studio", label: "Studio" },
  { href: "/help", label: "Help" },
  { href: "/donate", label: "Donate" },
  { href: "/developers", label: "Developers" },
  { href: studio.githubOrg, label: "GitHub" },
];
---

<EswFooter
  items={items}
  badgeSrc="/images/brand/badge.png"
  credit="Extra Special Studio"
  siteHref={studio.canonical}
  siteLabel="extraspecialstudio.co.uk"
/>
