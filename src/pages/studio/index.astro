---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { studio, timeline } from "../../data/studio";
---

<BaseLayout
  title="Studio"
  description="About Extra Special Studio: games, mods, music, and technology."
  path="/studio"
>
  <h1>Studio</h1>
  <p class="lede">{studio.about}</p>
  <p>
    Organisation: <a href={studio.githubOrg}>ESS-Extra-Special-Studio on GitHub</a>
  </p>
  <h2 class="section-title">Timeline</h2>
  <div class="timeline">
    {
      timeline.map((item) => (
        <article>
          <h3>
            {item.year} · {item.title}
          </h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
