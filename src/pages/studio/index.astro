---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EswPageHeader from "../../../esw/components/EswPageHeader.astro";
import { studio, timeline } from "../../data/studio";
---

<BaseLayout
  title="Studio"
  description="About Extra Special Studio: games, mods, music, and technology."
  path="/studio"
>
  <EswPageHeader title="Studio" lede={studio.about} />
  <p>
    <a href={studio.githubOrg}>GitHub</a>
    · <a href={studio.discord} rel="noopener noreferrer">Discord</a>
    · <a href={studio.canonical}>extraspecialstudio.co.uk</a>
  </p>
  <h2 class="section-title">Timeline</h2>
  <div class="timeline">
    {
      timeline.map((item) => (
        <article>
          <h3>
            {item.year} · {item.title}
          </h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
