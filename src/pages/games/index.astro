---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { games } from "../../data/games";
---

<BaseLayout
  title="Games"
  description="Extra Special Studio games. Titles appear here only when they are public."
  path="/games"
>
  <h1>Games</h1>
  <p class="lede">
    Extra Special Studio also makes games. Nothing is listed here until it is meant to be public. Nothing here is marketed as a shipped store title until it actually is.
  </p>
  {
    games.length > 0 ? (
      <div class="grid">
        {games.map((game) => (
          <a class="card project-card" href={`/games/${game.id}`}>
            <div class="icon-ph" aria-hidden="true">
              {game.status}
            </div>
            <div>
              <h2>{game.name}</h2>
              <p>{game.short}</p>
              <span class="status">{game.status}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p>No public games to show yet.</p>
    )
  }
</BaseLayout>
