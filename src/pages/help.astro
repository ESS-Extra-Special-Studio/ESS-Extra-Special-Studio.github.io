---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalLinks from "../components/ExternalLinks.astro";
import { support } from "../data/support";
---

<BaseLayout
  title="Help"
  description="How to get support for Extra Special Studio mods, music, and the studio site."
  path="/help"
>
  <h1>Help</h1>
  <p class="lede">
    Web support will live here: how to report bugs, where to ask questions, and links to docs when they exist. Discord and a support inbox stay off this page until those addresses are real.
  </p>
  <h2 class="section-title">Right now</h2>
  <p>
    Minecraft mods are developed in the public Extra Special Studio GitHub organisation. Issues on the relevant repo are the current support path.
  </p>
  <ExternalLinks
    links={{
      github: support.githubOrg,
      discord: support.discord,
      email: support.email,
    }}
  />
</BaseLayout>
