---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EswPageHeader from "../../../esw/components/EswPageHeader.astro";
import { shop } from "../../data/shop";

export function getStaticPaths() {
  return shop.themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

const { theme } = Astro.props;
---

<BaseLayout
  title={`${theme.title} · Shop`}
  description={theme.lede}
  path={`/shop/${theme.slug}`}
>
  <EswPageHeader title={theme.title} lede={theme.lede} />
  <p class="actions">
    <a class="btn" href="/shop">All shop</a>
    <a class="btn ghost" href={`${shop.origin}/collections/${theme.handle}`}>Open on the till</a>
  </p>
  <section data-collection={theme.handle} aria-busy="true">
    <div class="grid shop-grid">
      <p class="muted">Loading the live catalogue…</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ origin: shop.origin, handle: theme.handle }}>
  const money = (value) => {
    const amount = Number(value);
    if (!Number.isFinite(amount)) return "";
    return `£${amount.toFixed(2)}`;
  };

  async function load() {
    const response = await fetch(`${origin}/collections/${handle}/products.json?limit=250`);
    if (!response.ok) throw new Error(String(response.status));
    const body = await response.json();
    return Array.isArray(body.products) ? body.products : [];
  }

  function card(product) {
    const link = document.createElement("a");
    link.className = "card shop-card";
    link.href = `${origin}/products/${product.handle}`;
    const image = product.images?.[0]?.src;
    if (image) {
      const img = document.createElement("img");
      img.src = image;
      img.alt = "";
      img.width = 480;
      img.height = 480;
      link.append(img);
    }
    const title = document.createElement("h3");
    title.textContent = product.title || "Print";
    const price = document.createElement("p");
    price.className = "price";
    price.textContent = money(product.variants?.[0]?.price);
    link.append(title, price);
    return link;
  }

  const section = document.querySelector("[data-collection]");
  const grid = section?.querySelector(".shop-grid");
  if (section && grid) {
    load()
      .then((products) => {
        grid.replaceChildren(...products.map(card));
        if (!products.length) grid.textContent = "Nothing in this collection yet.";
      })
      .catch(() => {
        grid.textContent = "The catalogue could not load. The till is still open.";
      })
      .finally(() => section.setAttribute("aria-busy", "false"));
  }
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .btn.ghost {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--text) 22%, transparent);
  }
  .shop-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: inherit;
    text-decoration: none;
  }
  .shop-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    background: var(--bg-elev);
  }
  .shop-card h3 {
    font-size: 1rem;
  }
  .price,
  .muted {
    color: var(--muted);
    margin: 0;
  }
</style>
