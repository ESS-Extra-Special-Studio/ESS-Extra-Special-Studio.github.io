---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExternalLinks from "../../components/ExternalLinks.astro";
import { mods, getMod, gameLabels, gameNotes, modGame } from "../../data/mods";

export function getStaticPaths() {
  return mods.map((mod) => ({ params: { slug: mod.id } }));
}

const { slug } = Astro.params;
const mod = getMod(slug!);
if (!mod) {
  throw new Error("Unknown mod");
}
const game = modGame(mod);
---

<BaseLayout title={mod.name} description={mod.short} path={`/mods/${mod.id}`}>
  <p><a href="/mods">← Mods</a></p>
  <header style="display:flex; gap:1rem; align-items:flex-start; margin: 1rem 0 1.5rem;">
    {
      mod.icon ? (
        <img
          class:list={["icon", mod.pixelIcon && "icon-pixel"]}
          src={mod.icon}
          alt=""
          width="128"
          height="128"
          style="width:128px;height:128px;"
        />
      ) : (
        <div class="icon-ph" style="width:64px;height:64px;" aria-hidden="true">
          ESS
        </div>
      )
    }
    <div>
      <h1>{mod.name}</h1>
      <span class="status">{mod.status}</span>
    </div>
  </header>
  <p class="lede">{mod.long}</p>
  {
    mod.stackNote && (
      <p>
        <strong>{mod.stackNote}</strong>
      </p>
    )
  }
  {
    (mod.mcVersions.length > 0 || mod.loaders.length > 0) && (
      <p>
        {mod.loaders.join(", ")}
        {mod.mcVersions.length ? ` · Minecraft ${mod.mcVersions.join(", ")}` : ""}
        {game !== "minecraft" ? ` · ${gameLabels[game]}` : ""}
      </p>
    )
  }
  <ExternalLinks links={mod.links} />
  {mod.details?.map((text) => <p>{text}</p>)}
  {
    mod.screenshots && mod.screenshots.length > 0 && (
      <div class="grid screenshots">
        {mod.screenshots.map((shot) => (
          <a href={shot.src}>
            <img src={shot.src} alt={shot.alt} width="1600" height="842" loading="lazy" />
          </a>
        ))}
      </div>
    )
  }
  {gameNotes[game] && <p class="game-note">{gameNotes[game]}</p>}
</BaseLayout>

<style>
  .screenshots {
    margin: 1.5rem 0;
  }
  .screenshots img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .game-note {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
