---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import StackDiagram from "../../components/StackDiagram.astro";
import EswPageHeader from "../../../esw/components/EswPageHeader.astro";
import {
  ecosystemLabels,
  gameLabels,
  gameNotes,
  gameOrder,
  modsByEcosystem,
  type Ecosystem,
} from "../../data/mods";

const ecosystems: Ecosystem[] = ["ess", "pantheon", "dead-air", "other", "ashenfall"];
---

<BaseLayout
  title="Mods"
  description="Extra Special Studio mods, grouped by game: Minecraft, and Skills of Ashenfall for RuneScape: Dragonwilds."
  path="/mods"
>
  <EswPageHeader
    title="Mods"
    lede="Grouped by game. Minecraft first, then RuneScape: Dragonwilds, where Skills of Ashenfall adds new skills to the game. Status is honest: ESG is in development, ESB is planned. Radio Towers is a companion to Dead Air, not an Extra Special Studio mod."
  />
  <p class="lede">
    Soft merch lives on the studio <a href="/shop">Shop</a> — quiet prints and goods, separate from the mod downloads.
  </p>

  {
    gameOrder.map((game) => {
      const groups = ecosystems
        .map((eco) => ({ eco, items: modsByEcosystem(eco, game) }))
        .filter((g) => g.items.length > 0);
      return (
        <section class="game-block">
          <h2 class="game-title">{gameLabels[game]}</h2>
          {game === "minecraft" && <StackDiagram />}
          {gameNotes[game] && <p class="lede">{gameNotes[game]}</p>}
          {groups.map(({ eco, items }) => (
            <section>
              <h3 class="section-title">{ecosystemLabels[eco]}</h3>
              <div class="grid">
                {items.map((mod) => (
                  <ProjectCard mod={mod} />
                ))}
              </div>
            </section>
          ))}
        </section>
      );
    })
  }
</BaseLayout>
