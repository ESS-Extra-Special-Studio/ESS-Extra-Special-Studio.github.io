---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EswPageHeader from "../../../esw/components/EswPageHeader.astro";
import EswProjectCard from "../../../esw/components/EswProjectCard.astro";
import { artists } from "../../data/music";
---

<BaseLayout
  title="Music"
  description="Parallel Horizons and Extra Special Studio music."
  path="/music"
>
  <EswPageHeader
    title="Music"
    lede="Music is a studio pillar, not a sidebar. Parallel Horizons is the public music identity. Individual tracks are not dumped on the homepage."
  />
  <div class="grid">
    {
      artists.map((artist) => (
        <EswProjectCard
          href={`/music/${artist.id}`}
          title={artist.name}
          description={artist.blurb}
        />
      ))
    }
  </div>
</BaseLayout>
