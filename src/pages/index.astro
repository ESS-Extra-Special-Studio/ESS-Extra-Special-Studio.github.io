---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EswHero from "../../esw/components/EswHero.astro";
import EswNewsList from "../../esw/components/EswNewsList.astro";
import { studio } from "../data/studio";
import { news } from "../data/news";
import { featuredModIds } from "../data/featured";
import { getMod } from "../data/mods";
import { getOpenPolls } from "../data/polls";

const featured = featuredModIds.map((id) => getMod(id)).filter(Boolean);
const openPolls = getOpenPolls();
---

<BaseLayout title="Extra Special Studio" description={studio.tagline} path="/">
  <EswHero
    wordmarkSrc="/images/brand/wordmark.png"
    wordmarkAlt="Extra Special Studio"
    title={studio.tagline}
    lede={studio.intro}
  />

  <section class="pillars" aria-label="Pillars">
    <a class="card" href="/mods">
      <h2>Mods</h2>
      <p>Minecraft mods and the Extra Special stack. Dead Air, hub tools, utilities.</p>
    </a>
    <a class="card" href="/modpacks">
      <h2>Modpacks</h2>
      <p>Creatopia Unbound and C.ideas on CurseForge.</p>
    </a>
    <a class="card" href="/music">
      <h2>Music</h2>
      <p>Parallel Horizons. Albums and singles as they exist — no filler catalogues.</p>
    </a>
    <a class="card" href="/shop">
      <h2>Shop</h2>
      <p>Prints and goods, printed to order. Payment stays on the shop.</p>
    </a>
    <a class="card" href="/games">
      <h2>Games</h2>
      <p>Games will be listed here when there is something public to show.</p>
    </a>
    <a class="card" href="/software">
      <h2>Software</h2>
      <p>Extra Special Web and other studio tools. Not Minecraft mods.</p>
    </a>
  </section>

  <section class="home-shop" aria-label="Studio prints">
    <h2 class="section-title">Studio prints</h2>
    <p class="lede">Quiet prints and goods, printed to order. No ads — just the catalogue on the studio site.</p>
    <div class="grid shop-home-grid" id="home-shop-grid" aria-busy="true">
      <p class="muted">Loading a few live pieces…</p>
    </div>
    <p><a class="btn" href="/shop">Browse the shop</a></p>
  </section>

  <h2 class="section-title">Latest</h2>
  <EswNewsList items={news} />

  <script define:vars={{ origin: "https://ga0jn9-gj.myshopify.com" }}>
    const money = (value) => {
      const amount = Number(value);
      if (!Number.isFinite(amount)) return "";
      return `£${amount.toFixed(2)}`;
    };
    const grid = document.getElementById("home-shop-grid");
    if (grid) {
      fetch(`${origin}/collections/all/products.json?limit=250`)
        .then((res) => res.json())
        .then((body) => {
          const products = (body.products || [])
            .slice()
            .sort((a, b) => String(b.created_at || "").localeCompare(String(a.created_at || "")))
            .slice(0, 4);
          grid.replaceChildren(
            ...products.map((product) => {
              const link = document.createElement("a");
              link.className = "card shop-card";
              link.href = `${origin}/products/${product.handle}`;
              const image = product.images?.[0]?.src;
              if (image) {
                const img = document.createElement("img");
                img.src = image;
                img.alt = "";
                img.width = 480;
                img.height = 480;
                link.append(img);
              }
              const title = document.createElement("h3");
              title.textContent = product.title || "Print";
              const price = document.createElement("p");
              price.className = "price";
              price.textContent = money(product.variants?.[0]?.price);
              link.append(title, price);
              return link;
            })
          );
          if (!products.length) grid.textContent = "The shop catalogue is warming up.";
        })
        .catch(() => {
          grid.innerHTML = '<p class="muted">Browse the <a href="/shop">shop</a> for live prints.</p>';
        })
        .finally(() => grid.setAttribute("aria-busy", "false"));
    }
  </script>

  <style>
    .home-shop {
      margin: 2rem 0 2.5rem;
    }
    .shop-card {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      color: inherit;
      text-decoration: none;
    }
    .shop-card img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 8px;
      background: var(--bg-elev);
    }
    .shop-card h3 {
      font-size: 1rem;
      margin: 0;
    }
    .price,
    .muted {
      color: var(--muted);
      margin: 0;
    }
  </style>

  {openPolls.length > 0 && (
    <section class="community-votes" aria-label="Community votes">
      <h2 class="section-title">Community votes</h2>
      <p>{openPolls.length} vote{openPolls.length === 1 ? "" : "s"} currently open.</p>
      <ul>
        {openPolls.map((poll) => (
          <li><a href={`/vote/${poll.id}`}>{poll.title}</a></li>
        ))}
      </ul>
      <p><a class="btn" href="/vote">Vote now</a></p>
    </section>
  )}

  <h2 class="section-title">Featured mods</h2>
  <div class="grid">
    {featured.map((mod) => (mod ? <ProjectCard mod={mod} /> : null))}
  </div>

  <p style="margin-top: 2rem;">
    <a class="btn" href="/studio">About the studio</a>
  </p>
</BaseLayout>
