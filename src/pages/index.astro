---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import EswHero from "../../esw/components/EswHero.astro";
import EswNewsList from "../../esw/components/EswNewsList.astro";
import { studio } from "../data/studio";
import { news } from "../data/news";
import { featuredModIds } from "../data/featured";
import { getMod } from "../data/mods";

const featured = featuredModIds.map((id) => getMod(id)).filter(Boolean);
---

<BaseLayout title="Extra Special Studio" description={studio.tagline} path="/">
  <EswHero
    wordmarkSrc="/images/brand/wordmark.png"
    wordmarkAlt="Extra Special Studio"
    title={studio.tagline}
    lede={studio.intro}
  />

  <section class="pillars" aria-label="Pillars">
    <a class="card" href="/mods">
      <h2>Mods</h2>
      <p>Minecraft mods and the Extra Special stack. Dead Air, hub tools, utilities.</p>
    </a>
    <a class="card" href="/music">
      <h2>Music</h2>
      <p>Parallel Horizons. Albums and singles as they exist — no filler catalogues.</p>
    </a>
    <a class="card" href="/games">
      <h2>Games</h2>
      <p>Games will be listed here when there is something public to show.</p>
    </a>
    <a class="card" href="/software">
      <h2>Software</h2>
      <p>Extra Special Web and other studio tools. Not Minecraft mods.</p>
    </a>
  </section>

  <h2 class="section-title">Latest</h2>
  <EswNewsList items={news} />

  <h2 class="section-title">Featured mods</h2>
  <div class="grid">
    {featured.map((mod) => (mod ? <ProjectCard mod={mod} /> : null))}
  </div>

  <p style="margin-top: 2rem;">
    <a class="btn" href="/studio">About the studio</a>
  </p>
</BaseLayout>
